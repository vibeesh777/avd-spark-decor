# Copy this file to .env and fill in your values (never commit .env)
PORT=5000

# ── Admin panel (REQUIRED — login is disabled until this is set) ──
ADMIN_PASSWORD=choose-a-long-unique-password
# Optional separate key used to sign login tokens (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# ── Frontend URL(s) allowed to call this API (comma-separated) ──
CLIENT_URL=http://localhost:5173,https://avd-spark-decor.vercel.app

# ── Image uploads (cloudinary.com → free account) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Data storage (jsonbin.io → free account; create one bin) ──
JSONBIN_API_KEY=
JSONBIN_BIN_ID=              # bin starting as {"designs": []}
